# QuantNova AI - Backend Environment Configuration

# Database Connection (PostgreSQL)
# Local development format:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/quantnova_db
#
# Render Production format (Internal Connection String):
# DATABASE_URL=postgresql+psycopg://quantnova_db_user:password@dpg-xxxxxx-a.oregon-postgres.render.com/quantnova_db
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/quantnova_db

# Application Configuration
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
